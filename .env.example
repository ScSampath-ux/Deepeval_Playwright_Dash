# Copy this file to ".env" and fill in your values.

# AWS Bedrock / Evaluator Configuration
# Authenticate via named AWS profile (e.g., ~/.aws/credentials) OR access keys:
AWS_REGION=us-west-2
AWS_USER=your_aws_profile_name
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0

# Or using direct access keys (optional alternative to AWS_USER):
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Web Shipping Portal & Chatbot E2E Configuration
SHIPPING_PORTAL_URL=https://qa.shipconsole.com/ShipConsole/login
PORTAL_USERNAME=your_username
PORTAL_PASSWORD=your_password

# DeepEval Local Execution Settings (100% offline & local - zero cloud upload)
DEEPEVAL_TELEMETRY=no
DEEPEVAL_CONFIDENT_AI_OPT_OUT=YES
